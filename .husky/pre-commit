set -eu

invalid_migrations="$(git diff --cached --name-only --diff-filter=A -- 'supabase/migrations/*' | while IFS= read -r file; do
	name="${file##*/}"
	if ! printf '%s\n' "$name" | grep -Eq '^[0-9]{14}_[a-z0-9_]+\.sql$'; then
		printf '%s\n' "$file"
	fi
done)"

if [ -n "$invalid_migrations" ]; then
	printf 'Invalid staged migration filename(s):\n%s\n' "$invalid_migrations" >&2
	printf 'Expected: ^[0-9]{14}_[a-z0-9_]+\\.sql$\n' >&2
	exit 1
fi

# Scan staged content for common credential patterns before formatting.
PATTERN="AKIA[0-9A-Z]{16}|-----BEGIN (RSA )?PRIVATE KEY-----|-----BEGIN OPENSSH PRIVATE KEY-----|sk_live_[A-Za-z0-9]{16,}|xox[baprs]-[A-Za-z0-9-]{16,}|sq0atp-[A-Za-z0-9-]{16,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}"
git diff --cached --name-only |
while IFS= read -r file; do
	if [ "$file" = ".husky/pre-commit" ]; then
		continue
	fi
	if git show :"$file" 2>/dev/null | head -c 8000 | grep -I -n -E "$PATTERN" >/dev/null 2>&1; then
		echo "Potential secret found in staged file: $file" >&2
		exit 1
	fi
done

npx lint-staged
